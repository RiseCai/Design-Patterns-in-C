@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title TWS录音系统完整解决方案时序图 - 全场景融合

actor 用户 as User
participant "充电盒主控" as Case
participant "主耳机(Left)" as Master
participant "从耳机(Right)" as Slave
participant "链路质量监测" as LinkMon
participant "缓存管理器" as CacheMgr
participant "流控管理器" as FlowCtrl
participant "存储决策器" as StorageDec
participant "Flash引擎(NOR)" as FlashNOR
participant "Flash引擎(NAND)" as FlashNAND
participant "聚合器" as Aggregator

== 场景1: 盒录音常态流程（链路良好） ==

User -> Case: pressRecordButton()
activate Case
Case -> Case: detectEarbudsStatus() → IN_CASE
Case -> StorageDec: setRecordingSource(CASE_MIC)
Case -> Case: initRecordingParams(48kHz, 48kbps)

group 资源分配
    Case -> CacheMgr: createCache(session_id=201, max_size=16KB, type=CASE_LOCAL)
    CacheMgr --> Case: cache_handle, threshold=12KB(80%)
    Case -> FlashNAND: openPartition(CASE_LOCAL, mode=CACHE)
    FlashNAND --> Case: partition_handle, base=0x80000000
    Case -> FlashNAND: writeSessionMeta(session=201, start_time=1698840000)\n双备份(扇区0/1轮询)
end

Case -> Case: startAudioCapture()
Case -> FlowCtrl: config(bitrate=48kbps, capacity=80kbps, mode=ADAPTIVE)

loop 每50ms (300B数据块)
    Case -> Case: captureAudioBlock(50ms)
    Case -> CacheMgr: writeCache(data, timestamp, size=300B)
    activate CacheMgr
    CacheMgr -> CacheMgr: updateUsage(+300B)\n当前=3.6KB
    CacheMgr --> Case: CACHE_NORMAL
    deactivate CacheMgr
    
    alt 每200ms同步周期
        Case -> FlowCtrl: requestSyncQuota(size=1200B, priority=NORMAL)
        activate FlowCtrl
        FlowCtrl -> LinkMon: queryLinkQuality()
        activate LinkMon
        LinkMon --> FlowCtrl: RSSI=-58dBm, loss=3%, rtt=15ms
        deactivate LinkMon
        
        alt 链路良好
            FlowCtrl --> Case: quotaGranted=true, max_latency=50ms
            deactivate FlowCtrl
            
            Case -> StorageDec: decideStrategy(link=GOOD, cache=45%)
            activate StorageDec
            StorageDec --> Case: STRATEGY_REALTIME_ONLY
            deactivate StorageDec
            
            Case -> FlashNAND: appendToCache(data_batch, size=1200B)\n地址: 0x80000000 + page_offset
            activate FlashNAND
            FlashNAND -> FlashNAND: programPage(page_id=42, data)\n耗时=12ms
            FlashNAND --> Case: ACK
            deactivate FlashNAND
            
            Case -> CacheMgr: flushSynced(1200B)\n释放缓存\n剩余=2.4KB
        end
    end
end

Case -> Case: stopRecording()
Case -> Aggregator: startAggregating(session_id=201)

== 场景2: 耳机录音 + 主从切换（电量触发） ==

User -> Master: earbudRemoved() → 电量L=78%, R=82%
Master -> Master: becomeMaster(session=202)
Slave -> Slave: becomeSlave(session=202)

User -> Master: startRecording()

group 耳机初始化（RAM紧张）
    Master -> CacheMgr: createCache(session=202, max_size=12KB, type=CALL_RECORD)\n实际可用: 12KB
    CacheMgr --> Master: cache_handle, threshold=9.6KB(80%)
    Master -> FlashNOR: openBackupPartition(base=0x9E2000, size=20MB)
    FlashNOR --> Master: backup_handle
end

loop 每30ms捕获 (180B)
    Master -> Master: captureOpus(30ms)
    Master -> CacheMgr: writeCache(data, size=180B)
    activate CacheMgr
    CacheMgr -> CacheMgr: updateUsage(+180B)\n当前=5.8KB
    
    alt 达到高水位(>9.6KB)
        CacheMgr --> Master: ALERT_HIGH_WATERMARK\n剩余=200ms
        Master -> StorageDec: emergencyDecision(cache=80%, link_quality=BAD)
        activate StorageDec
        StorageDec --> Master: DECISION_BACKUP_PARALLEL
        deactivate StorageDec
        
        par 同步路径
            Master -> FlowCtrl: requestSyncQuota(size=1440B, priority=URGENT)
            FlowCtrl --> Master: quotaGranted, latency=40ms
            Master -> FlashNAND: remoteAppend(session=202, data)\n蓝牙传输
        and 备份路径
            Master -> FlashNOR: backupSlice(slice_id=1501, data)
            activate FlashNOR
            FlashNOR -> FlashNOR: eraseSector(backup_idx%2558)\n写5页
            FlashNOR -> FlashNOR: writeMetaWearLeveling()\n扇区=8925%8=5
            FlashNOR --> Master: BACKUP_OK
            deactivate FlashNOR
        end
    else 缓存正常
        Master -> FlowCtrl: checkLinkQuality()
        FlowCtrl --> Master: LINK_GOOD
        Master -> FlashNAND: remoteAppend(data)\n仅同步
    end
    
    deactivate CacheMgr
end

== 场景3: 链路中断 + 盲窗标记 ==

LinkMon --> Master: onLinkBroken(timestamp=1698840123, rss=90%)

group 中断处理（PUML核心）
    Master -> Master: markBlindGapStart(seq=12450, timestamp=1698840123)
    Master -> CacheMgr: queryRemainingCapacity()
    activate CacheMgr
    CacheMgr --> Master: remaining=1.2KB (200ms)
    deactivate CacheMgr
    
    alt 快速重连（100ms内）
        Master -> LinkMon: attemptFastReconnect(timeout=100ms, max_retry=2)
        LinkMon --> Master: success (took=67ms)
        Master -> Master: markBlindGapEnd(timestamp=1698840190)\n盲窗=67ms
        Master -> FlashNOR: updateMetaBlindGap(session=202, gap_start=12450, gap_end=12472)\n元数据持久化
    else 重连失败
        CacheMgr --> Master: CACHE_CRITICAL
        Master -> StorageDec: emergencyDecision(link=BROKEN, cache=95%)
        StorageDec --> Master: DECISION_QUALITY_DEGRADE\n48kbps→32kbps
        Master -> Slave: notifyBitrateReduction(32kbps)\n从耳同步降码率
    end
end

== 场景4: 主从切换（电量触发） ==

Master -> LinkMon: evaluateSwitchNeed()\nL=28%(B₁), R=65%(B₀)

LinkMon --> Master: switchRecommended(new_master=RIGHT)

group 切换前准备
    Master -> Slave: prepareSwitch(session=202, handover_time=300ms)
    activate Slave
    Slave -> CacheMgr: createPreemptiveCache(max_size=10KB)\n预录到独立Flash区
    Slave -> FlashNOR: openPreemptPartition()\nsector_range=2500-2557
end

Master -> CacheMgr: queryUnsyncedData()\nunsynced=2.4KB (slice=12447-54)

group 强制同步剩余数据
    Master -> FlowCtrl: requestEmergencySync(size=2.4KB, priority=CRITICAL)
    FlowCtrl --> Master: quotaGranted, max_latency=50ms
    
    Master -> FlashNOR: readBackupSlices(range=12447-54)
    FlashNOR --> Master: slice_data
    
    par 传输并行
        loop 每个分片
            Master -> FlashNAND: remoteAppend(slice_data, meta)\n蓝牙SPP
            FlashNAND --> Master: ACK
        end
    and 擦除并行
        loop 已同步分片
            Master -> FlashNOR: eraseBackupSector(slice_id)\n释放空间
        end
    end
end

Master -> Slave: sendSwitchCommit(timestamp=1698840300, last_sync=12454)
Slave -> Slave: becomeMaster(session=202)

group 预录数据合并
    Slave -> FlashNOR: mergePreemptiveCache()\n读取预录分片=12455-60
    FlashNOR -> FlashNOR: detectOverlap(预录 vs 已同步)\n发现: 3个分片重叠(12455-57)
    FlashNOR --> Slave: discardOverlapped(3)\nretainNonOverlapped(3)
    Slave -> CacheMgr: transferCacheOwnership()\n剩余缓存=1.2KB
    Slave -> Case: notifySwitchComplete(new_master=RIGHT)\n无缝切换
end

== 场景5: 聚合与盲窗处理 ==

Case -> Aggregator: startAggregating(session=202, sources=[LEFT,RIGHT])

group 加载元数据与盲窗检测
    Aggregator -> FlashNAND: loadMetadataWithBlindMarkers(session=202)
    FlashNAND --> Aggregator: 66分片 + blind_gap_start=12450 + blind_gap_end=12472\n盲窗时长=220ms
    
    Aggregator -> Aggregator: classifyBlindGapSeverity(duration=220ms)\n等级: MEDIUM (50~200ms)
end

group 分批聚合（PDF机制）
    loop batch=0..1 (每批50个分片)
        Aggregator -> FlashNAND: loadBatchSlices(batch_id, count=50)
        FlashNAND --> Aggregator: slice_data_stream
        
        Aggregator -> Aggregator: sortByTimestamp()\ndeduplicateBySliceId()
        
        alt 盲窗处理策略
            Aggregator -> Aggregator: fillSilence(duration=220ms)\n生成静音数据
            Aggregator -> FlashNAND: writeGapMarker(position=12450, type=LINK_FAILURE)\n文件内标记
        end
        
        Aggregator -> FlashNAND: appendToFinalFile(data, size=200KB)\n循环写入4KB块
    end
end

group 生成报告
    Aggregator -> Aggregator: calculateContinuityIndex()\nCI = 96.7%
    Aggregator -> FlashNAND: writeMergerReport(gap_list=[{start:12450, duration:220ms, type:link_failure}])
    FlashNAND --> Aggregator: 报告持久化
    
    Aggregator --> Case: aggregationResult(files=2, CI=96.7%, blind_gaps=1)
end

Case -> User: notifyComplete(path="/record/call/REC_202_PART1.opus", quality="CI=96.7%")

== 场景6: 断电恢复（Flash寿命保障） ==

note over Master: ⚠️ 电量耗尽 (0%) 正在写slice=12463

User -> Master: power_on()

group 重启恢复
    Master -> FlashNOR: checkPowerLossRecovery()
    FlashNOR -> FlashNOR: scanMetaBackupSectors(0-7)\n最新元数据在扇区5 (erase_count=8925)
    FlashNOR -> FlashNOR: validatePartialSlice(slice=12463)\n发现: 仅3/5页写入
    FlashNOR --> Master: markSliceInvalid(slice=12463)\nrecoverToLastValid(slice=12462)
    
    Master -> Case: reconnectAndRequestSync(last_slice=12462)
    Case -> Master: requestMissing(slice=12463)
    Master -> FlashNOR: readBackup(slice=12464-65)\n补传剩余
    FlashNOR -> FlashNOR: eraseSyncedSectors(12464-65)\n释放空间
    
    FlashNOR --> Master: recoveryComplete\n丢失分片: 0
end

note right of Master: <font color=green>✓ Flash磨损均衡正常\n扇区平均擦写8925次\n预计寿命: 8925/365 = 24.4年</font>

== 关键API清单 ==

note over Case, Aggregator
    <b>核心API（整合版）</b>
    
    <font color=blue>状态机API:</font>
    - record_state_machine_init()
    - record_state_transition(event, ctx)
    - record_state_get_coverage() → 95%
    
    <font color=blue>决策API:</font>
    - record_make_decision(input) → output策略
    - record_estimate_continuity(strategy) → CI预测值
    
    <font color=blue>缓存API:</font>
    - cache_create/max_size/threshold
    - cache_write/auto_monitor
    - cache_get_remaining_ms() → 200ms
    
    <font color=blue>Flash增强API:</font>
    - flash_write_meta_wear_leveling() → 扇区轮询
    - flash_atomic_write_begin/commit() → 断电保护
    - flash_check_power_loss() → 恢复检测
    
    <font color=blue>盲窗处理API:</font>
    - record_mark_blind_gap(start/end)
    - aggregator_detect_gap_severity() → NONE/LIGHT/MEDIUM/HEAVY
    - aggregator_fill_gap() → 插值/静音/分割
    
    <font color=red>性能指标:</font>
    - 盲窗平均: <50ms (链路中断)
    - 切换盲窗: 0ms (强制同步)
    - Flash寿命: >10年 (80k次预警)
    - 缓存命中率: >98% (12KB配置)
    - CI达标率: >96% (Monte Carlo)
end note

deactivate Case

@enduml