@startuml
allowmixing
title System Coordinator with All Subsystems - Activation Relationships

skinparam state {
  BackgroundColor<<normal>> White
  BorderColor<<normal>> Black
  BackgroundColor<<error>> LightCoral
  BorderColor<<error>> DarkRed
  BackgroundColor<<active>> LightGreen
  BorderColor<<active>> DarkGreen
  FontSize 13
}

skinparam frame {
  BackgroundColor<<subsystem>> #E6F3FF
  BorderColor<<subsystem>> #0066CC
}

' ====================
' System Coordinator States (simplified)
' ====================

frame "System Coordinator" {
  state "SYS_INIT" as SYS_INIT <<normal>>
  state "SYS_IDLE" as SYS_IDLE <<active>>
  state "SYS_RECORDING" as SYS_REC <<active>>
  state "SYS_RECORDING_AND_UPLOADING" as SYS_REC_UPL <<active>>
  state "SYS_UPLOADING" as SYS_UPL <<active>>
  state "SYS_OTA" as SYS_OTA <<active>>
  state "SYS_ERROR" as SYS_ERROR <<error>>
  state "SYS_SLEEP" as SYS_SLEEP <<normal>>
  state "SYS_SHUTDOWN" as SYS_SHUTDOWN <<normal>>
  state "SYS_RESET" as SYS_RESET <<normal>>

  ' Transitions (simplified)
  state "initial" <<hidden>>
  initial --> SYS_INIT
  SYS_INIT --> SYS_IDLE : Auto
  SYS_IDLE --> SYS_REC : REC_START
  SYS_REC --> SYS_REC_UPL : STREAMING_START
  SYS_REC --> SYS_UPL : REC_STOP
  SYS_REC_UPL --> SYS_REC : STREAMING_STOP
  SYS_REC_UPL --> SYS_UPL : REC_STOP
  SYS_UPL --> SYS_IDLE : UPLOAD_COMPLETE
  SYS_IDLE --> SYS_SLEEP : LOW_BATTERY
  SYS_SLEEP --> SYS_IDLE : POWER_ON
  SYS_IDLE --> SYS_OTA : OTA_START
  SYS_OTA --> SYS_IDLE : OTA_COMPLETE
  SYS_ERROR --> SYS_RESET : RESET
  SYS_RESET --> SYS_INIT : Auto
}

' ====================
' Subsystem FSMs (simplified)
' ====================

frame "Subsystem: Recording FSM" <<subsystem>> {
  state "REC_IDLE" as REC_IDLE
  state "REC_RECORDING" as REC_REC
  state "REC_PAUSED" as REC_PAUSED
  state "REC_STOPPED" as REC_STOPPED
  state "REC_UPLOADING" as REC_UPLOADING
  state "REC_ERROR" as REC_ERROR

  state "initial_rec" <<hidden>>
  initial_rec --> REC_IDLE
  REC_IDLE --> REC_REC : REC_START
  REC_REC --> REC_PAUSED : REC_PAUSE
  REC_PAUSED --> REC_REC : REC_RESUME
  REC_REC --> REC_STOPPED : REC_STOP
  REC_STOPPED --> REC_UPLOADING : UPLOAD_START
  REC_UPLOADING --> REC_IDLE : UPLOAD_COMPLETE
}

frame "Subsystem: Audio FSM" <<subsystem>> {
  state "AUDIO_OFF" as AUD_OFF
  state "AUDIO_IDLE" as AUD_IDLE
  state "AUDIO_PLAYING" as AUD_PLAYING
  state "AUDIO_PAUSED" as AUD_PAUSED
  state "AUDIO_RECORDING" as AUD_REC
  state "AUDIO_ERROR" as AUD_ERROR

  state "initial_audio" <<hidden>>
  initial_audio --> AUD_OFF
  AUD_OFF --> AUD_IDLE : PLAY
  AUD_IDLE --> AUD_PLAYING : PLAY
  AUD_PLAYING --> AUD_PAUSED : PAUSE
  AUD_PAUSED --> AUD_PLAYING : PLAY
  AUD_IDLE --> AUD_REC : RECORD_START
  AUD_REC --> AUD_IDLE : RECORD_STOP
}

frame "Subsystem: Communication FSM" <<subsystem>> {
  state "COMM_IDLE" as COMM_IDLE
  state "COMM_CONNECTING" as COMM_CONNECTING
  state "COMM_CONNECTED" as COMM_CONNECTED
  state "COMM_TRANSFERRING" as COMM_TRANSFERRING
  state "COMM_DISCONNECTING" as COMM_DISCONNECTING
  state "COMM_ERROR" as COMM_ERROR

  state "initial_comm" <<hidden>>
  initial_comm --> COMM_IDLE
  COMM_IDLE --> COMM_CONNECTING : CONNECT
  COMM_CONNECTING --> COMM_CONNECTED : CONNECTED
  COMM_CONNECTED --> COMM_TRANSFERRING : TRANSFER_START
  COMM_TRANSFERRING --> COMM_CONNECTED : TRANSFER_COMPLETE
  COMM_CONNECTED --> COMM_DISCONNECTING : DISCONNECT
  COMM_DISCONNECTING --> COMM_IDLE : DISCONNECTED
}

frame "Subsystem: Power FSM" <<subsystem>> {
  state "POWER_ON" as PWR_ON
  state "POWER_OFF" as PWR_OFF
  state "POWER_LOW_BATTERY" as PWR_LOW
  state "POWER_CHARGING" as PWR_CHARGING
  state "POWER_SLEEP" as PWR_SLEEP

  state "initial_power" <<hidden>>
  initial_power --> PWR_ON
  PWR_ON --> PWR_LOW : LOW_BATTERY
  PWR_LOW --> PWR_SLEEP : SLEEP
  PWR_SLEEP --> PWR_ON : POWER_ON
  PWR_ON --> PWR_CHARGING : CHARGING_START
  PWR_CHARGING --> PWR_ON : CHARGING_COMPLETE
  PWR_ON --> PWR_OFF : POWER_OFF
}

frame "Subsystem: OTA FSM" <<subsystem>> {
  state "OTA_IDLE" as OTA_IDLE
  state "OTA_CHECKING" as OTA_CHECKING
  state "OTA_DOWNLOADING" as OTA_DOWNLOADING
  state "OTA_VERIFYING" as OTA_VERIFYING
  state "OTA_INSTALLING" as OTA_INSTALLING
  state "OTA_COMPLETE" as OTA_COMPLETE
  state "OTA_ERROR" as OTA_ERROR

  state "initial_ota" <<hidden>>
  initial_ota --> OTA_IDLE
  OTA_IDLE --> OTA_CHECKING : OTA_CHECK
  OTA_CHECKING --> OTA_DOWNLOADING : UPDATE_AVAILABLE
  OTA_DOWNLOADING --> OTA_VERIFYING : DOWNLOAD_COMPLETE
  OTA_VERIFYING --> OTA_INSTALLING : VERIFICATION_OK
  OTA_INSTALLING --> OTA_COMPLETE : INSTALL_COMPLETE
  OTA_COMPLETE --> OTA_IDLE : RESET
}

' ====================
' Activation Relationships (dashed arrows)
' ====================

SYS_REC ..> REC_REC : activates
SYS_REC ..> AUD_REC : activates
SYS_REC_UPL ..> REC_REC : activates
SYS_REC_UPL ..> AUD_REC : activates
SYS_REC_UPL ..> COMM_TRANSFERRING : activates
SYS_UPL ..> COMM_TRANSFERRING : activates
SYS_UPL ..> REC_UPLOADING : activates
SYS_OTA ..> OTA_DOWNLOADING : activates
SYS_IDLE ..> PWR_ON : activates
SYS_IDLE ..> COMM_CONNECTED : activates
SYS_SLEEP ..> PWR_SLEEP : activates
SYS_ERROR ..> REC_ERROR : may activate
SYS_ERROR ..> AUD_ERROR : may activate
SYS_ERROR ..> COMM_ERROR : may activate
SYS_ERROR ..> OTA_ERROR : may activate
SYS_ERROR ..> PWR_LOW : may activate

note right of SYS_REC
  <b>Activates:</b>
  • Recording FSM (REC_RECORDING)
  • Audio FSM (AUDIO_RECORDING)
end note

note right of SYS_REC_UPL
  <b>Activates:</b>
  • Recording FSM (REC_RECORDING)
  • Audio FSM (AUDIO_RECORDING)
  • Communication FSM (COMM_TRANSFERRING)
end note

note right of SYS_OTA
  <b>Activates:</b>
  • OTA FSM (OTA_DOWNLOADING)
end note

note right of SYS_SLEEP
  <b>Activates:</b>
  • Power FSM (POWER_SLEEP)
end note

note bottom
  <b>Legend:</b>
  • Solid arrows: state transitions within each FSM.
  • Dashed arrows (..>): activation relationships (system coordinator state activates subsystem state).
  • Colors: Green = active system state, Red = error, Blue = subsystem frames.
end note

@enduml
