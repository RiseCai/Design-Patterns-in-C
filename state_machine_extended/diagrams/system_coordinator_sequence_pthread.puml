@startuml
title System Coordinator API Call Sequence (TWS Earphone System) with pthread Thread Mapping

' Define participants
actor "User" as USER
actor "External Device" as EXTDEV

' Define pthread boxes (virtual boxes)
box "Main Control Thread"
  participant "Test Program" as TEST
  participant "System Coordinator" as SYS
end box

box "Command Processing Thread"
  participant "External Command\nProcessor" as CMD_PROC
end box

box "Recording Thread"
  participant "Recording FSM" as REC
end box

box "Communication Thread"
  participant "Comm FSM" as COMM
end box

box "Power Management Thread"
  participant "Power FSM" as PWR
end box

box "OTA Thread"
  participant "OTA FSM" as OTA
end box

note over USER,COMM : Initialization Phase
USER -> TEST : Start test program
TEST -> SYS : system_coordinator_init()
SYS -> SYS : enter_init()
SYS -> SYS : do_action()
SYS -> TEST : Initialized (SYS_INIT)

note over USER,COMM : Scenario 1: Normal Recording Flow
USER -> TEST : Press record button
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_START)
SYS -> SYS : exit_state() from SYS_INIT
SYS -> SYS : enter_idle()
SYS -> SYS : do_action()
SYS -> REC : start_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> TEST : Transition to SYS_IDLE

TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_START)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : start_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> TEST : Transition to SYS_RECORDING

note over USER,COMM : Recording in progress...
SYS -> SYS : do_action() periodic
SYS -> REC : do_action()
REC -> REC : capture_audio()

USER -> TEST : Press stop button
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_STOP)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_uploading()
SYS -> SYS : do_action()
SYS -> COMM : start_upload()
COMM -> COMM : entry_action()
COMM -> COMM : do_action()
SYS -> TEST : Transition to SYS_UPLOADING

note over USER,COMM : Upload completes
COMM -> SYS : upload_complete_callback()
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_UPLOAD_COMPLETE)
SYS -> SYS : exit_state() from SYS_UPLOADING
SYS -> SYS : enter_idle()
SYS -> SYS : do_action()
SYS -> TEST : Transition to SYS_IDLE

note over USER,COMM : Scenario 2: Error Recovery Flow
USER -> TEST : Simulate error
TEST -> SYS : system_coordinator_set_error(1001, "Buffer overflow")
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_ERROR)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_error()
SYS -> SYS : do_action()
SYS -> REC : stop_recording()
REC -> REC : exit_action()
SYS -> TEST : Transition to SYS_ERROR

USER -> TEST : Reset system
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_RESET)
SYS -> SYS : exit_state() from SYS_ERROR
SYS -> SYS : enter_idle()
SYS -> SYS : do_action()
SYS -> TEST : Transition to SYS_IDLE

note over USER,COMM : Scenario 3: Power Management Flow
USER -> TEST : Low battery warning
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_LOW_BATTERY)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : enter_sleep()
SYS -> SYS : do_action()
SYS -> PWR : reduce_power()
PWR -> PWR : entry_action()
PWR -> PWR : do_action()
SYS -> TEST : Transition to SYS_SLEEP

USER -> TEST : Power off
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_POWER_OFF)
SYS -> SYS : exit_state() from SYS_SLEEP
SYS -> SYS : (none)  /* no entry function */
SYS -> SYS : do_action()
SYS -> PWR : power_off()
PWR -> PWR : exit_action()
SYS -> TEST : Transition to SYS_SHUTDOWN

note over USER,COMM : Scenario 4: External Device Control Command Flow

EXTDEV -> COMM : Send command via Bluetooth/4G
COMM -> COMM : COMM_EVT_DATA_RECEIVED
COMM -> CMD_PROC : Forward raw data
CMD_PROC -> CMD_PROC : external_command_processor_process_raw()
CMD_PROC -> CMD_PROC : Parse binary protocol
CMD_PROC -> CMD_PROC : Validate checksum
CMD_PROC -> CMD_PROC : Create command_message

note over CMD_PROC : Mode: Direct Event
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_START)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : start_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> CMD_PROC : Transition to SYS_RECORDING

CMD_PROC -> COMM : Send acknowledgment
COMM -> EXTDEV : Command acknowledged

note over EXTDEV,CMD_PROC : Mode: Callback with Queue
EXTDEV -> COMM : Send multiple commands
COMM -> CMD_PROC : Forward data
CMD_PROC -> CMD_PROC : Queue commands (priority based)
CMD_PROC -> CMD_PROC : Process queue periodically
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_STOP)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_uploading()
SYS -> SYS : do_action()
SYS -> COMM : start_upload()
COMM -> COMM : entry_action()
COMM -> COMM : do_action()
SYS -> CMD_PROC : Transition to SYS_UPLOADING

note over EXTDEV,CMD_PROC : Mode: Hybrid (Callback + Queue)
EXTDEV -> COMM : Send high priority command
COMM -> CMD_PROC : Forward data
CMD_PROC -> CMD_PROC : Priority >= threshold
CMD_PROC -> CMD_PROC : Immediate callback
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_POWER_OFF)
SYS -> SYS : exit_state() from SYS_UPLOADING
SYS -> SYS : enter_sleep()
SYS -> SYS : do_action()
SYS -> PWR : reduce_power()
PWR -> PWR : entry_action()
PWR -> PWR : do_action()
SYS -> CMD_PROC : Transition to SYS_SLEEP

CMD_PROC -> COMM : Send status update
COMM -> EXTDEV : System status: SLEEP mode

note over USER,COMM : Scenario 5: Advanced Recording Control Flow
note over EXTDEV,CMD_PROC : External device sends pause command
EXTDEV -> COMM : Send command CMD_REC_PAUSE
COMM -> CMD_PROC : Forward data
CMD_PROC -> CMD_PROC : Parse and validate
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_PAUSE)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_recording()  /* stays in recording but paused */
SYS -> SYS : do_action()
SYS -> REC : pause_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> CMD_PROC : Transition to SYS_RECORDING (paused)
CMD_PROC -> COMM : Send acknowledgment
COMM -> EXTDEV : Command acknowledged

note over EXTDEV,CMD_PROC : External device sends resume command
EXTDEV -> COMM : Send command CMD_REC_RESUME
COMM -> CMD_PROC : Forward data
CMD_PROC -> CMD_PROC : Parse and validate
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_RESUME)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : resume_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> CMD_PROC : Transition to SYS_RECORDING (active)
CMD_PROC -> COMM : Send acknowledgment
COMM -> EXTDEV : Command acknowledged

note over REC,SYS : Buffer full event (internal)
REC -> REC : REC_EVT_BUFFER_FULL
REC -> SYS : recording_fsm_dispatch_event(REC_EVT_BUFFER_FULL)
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_PAUSE)  /* auto-pause */
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : pause_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> COMM : Send notification to user
COMM -> EXTDEV : Buffer full, recording paused

note over REC,SYS : Multi-device synchronization
REC -> REC : REC_EVT_EARPHONE_READY
REC -> REC : REC_EVT_CASE_READY
REC -> SYS : Both devices ready
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_RESUME)  /* auto-resume after sync */
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : resume_recording()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> COMM : Send status update
COMM -> EXTDEV : Recording resumed after sync

note over USER,COMM : Scenario 6: External Device OTA Command Flow

note over EXTDEV,OTA : External device initiates OTA update
EXTDEV -> COMM : Send OTA_START command (binary)
COMM -> CMD_PROC : Forward raw data
CMD_PROC -> CMD_PROC : external_command_processor_process_raw()
CMD_PROC -> CMD_PROC : Parse command (CMD_OTA_START)
CMD_PROC -> CMD_PROC : Convert to SYS_EVT_OTA_START
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_OTA_START)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : enter_idle()  /* system stays idle, OTA FSM handles */
SYS -> SYS : do_action()
SYS -> OTA : ota_fsm_dispatch_event(OTA_EVT_START)
OTA -> OTA : entry_action()
OTA -> OTA : do_action()
OTA -> OTA : Transition from OTA_IDLE to OTA_CHECKING
OTA -> SYS : OTA status: CHECKING
SYS -> CMD_PROC : OTA started
CMD_PROC -> COMM : Send acknowledgment
COMM -> EXTDEV : OTA_START acknowledged

note over EXTDEV,OTA : OTA checking progress
OTA -> OTA : OTA_EVT_CHECK_COMPLETE
OTA -> SYS : ota_fsm_dispatch_event(OTA_EVT_CHECK_COMPLETE)
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_OTA_PROGRESS)
SYS -> SYS : do_action()
SYS -> COMM : Send progress update
COMM -> EXTDEV : OTA progress: 20%

note over EXTDEV,OTA : External device cancels OTA
EXTDEV -> COMM : Send OTA_CANCEL command
COMM -> CMD_PROC : Forward raw data
CMD_PROC -> CMD_PROC : Parse command (CMD_OTA_CANCEL)
CMD_PROC -> CMD_PROC : Convert to SYS_EVT_OTA_CANCEL
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_OTA_CANCEL)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : do_action()
SYS -> OTA : ota_fsm_dispatch_event(OTA_EVT_CANCEL)
OTA -> OTA : entry_action()
OTA -> OTA : do_action()
OTA -> OTA : Transition from OTA_CHECKING to OTA_IDLE
OTA -> SYS : OTA status: IDLE
SYS -> CMD_PROC : OTA cancelled
CMD_PROC -> COMM : Send acknowledgment
COMM -> EXTDEV : OTA_CANCEL acknowledged

note over EXTDEV,OTA : Alternative: OTA completes successfully
EXTDEV -> COMM : Send OTA_COMPLETE command (simulate)
COMM -> CMD_PROC : Forward raw data
CMD_PROC -> CMD_PROC : Parse command (CMD_OTA_COMPLETE)
CMD_PROC -> CMD_PROC : Convert to SYS_EVT_OTA_COMPLETE
CMD_PROC -> SYS : system_coordinator_dispatch_event(SYS_EVT_OTA_COMPLETE)
SYS -> SYS : exit_state() from SYS_IDLE
SYS -> SYS : do_action()
SYS -> OTA : ota_fsm_dispatch_event(OTA_EVT_COMPLETE)
OTA -> OTA : entry_action()
OTA -> OTA : do_action()
OTA -> OTA : Transition from OTA_CHECKING to OTA_IDLE
OTA -> SYS : OTA status: COMPLETED
SYS -> CMD_PROC : OTA completed
CMD_PROC -> COMM : Send final status
COMM -> EXTDEV : OTA_COMPLETE acknowledged

note over USER,COMM : Scenario 7: Enhanced Initialization and Subsystem Management

note over TEST,SYS : Complete subsystem initialization flow
TEST -> TEST : Create subsystem FSMs
TEST -> TEST : recording_fsm_create()
TEST -> TEST : comm_fsm_create()
TEST -> TEST : power_fsm_create()
TEST -> TEST : audio_fsm_create()
TEST -> TEST : efsm_protocol_create()
TEST -> TEST : ota_fsm_create()

TEST -> SYS : system_coordinator_set_recording_fsm()
TEST -> SYS : system_coordinator_set_comm_fsm()
TEST -> SYS : system_coordinator_set_power_fsm()
TEST -> SYS : system_coordinator_set_audio_fsm()
TEST -> SYS : system_coordinator_set_efsm_protocol()
TEST -> SYS : system_coordinator_set_ota_fsm()

USER -> TEST : Start test program
TEST -> SYS : system_coordinator_init()
SYS -> SYS : enter_init()
SYS -> REC : recording_fsm_init()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> SYS : Check for pending firmware update
SYS -> SYS : has_pending_update()

note over SYS : Pending update detected
SYS -> SYS : transition_to_state(SYS_OTA)
SYS -> SYS : exit_state() from SYS_INIT
SYS -> SYS : enter_ota()
SYS -> OTA : ota_fsm_dispatch_event(OTA_EVT_START)
OTA -> OTA : entry_action()
OTA -> OTA : do_action()
OTA -> OTA : Transition from OTA_IDLE to OTA_CHECKING
SYS -> TEST : System initialized in OTA state

note over USER,COMM : Scenario 8: State Query and Error Handling

TEST -> SYS : system_coordinator_get_state()
SYS -> TEST : Return SYS_OTA

TEST -> SYS : system_coordinator_get_state_name(SYS_OTA)
SYS -> TEST : Return "SYS_OTA"

TEST -> SYS : system_coordinator_get_event_name(SYS_EVT_OTA_START)
SYS -> TEST : Return "SYS_EVT_OTA_START"

note over TEST,SYS : Simulate OTA error
OTA -> OTA : OTA_EVT_ERROR
OTA -> SYS : ota_fsm_dispatch_event(OTA_EVT_ERROR)
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_OTA_ERROR)
SYS -> SYS : exit_state() from SYS_OTA
SYS -> SYS : enter_error()
SYS -> SYS : system_coordinator_set_error(5001, "OTA download failed")
SYS -> SYS : do_action()

TEST -> SYS : system_coordinator_get_error_code()
SYS -> TEST : Return 5001

TEST -> SYS : system_coordinator_get_error_msg()
SYS -> TEST : Return "OTA download failed"

note over USER,COMM : Scenario 9: Recording and Streaming Simultaneous Mode

USER -> TEST : Start recording with streaming
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_REC_START)
SYS -> SYS : exit_state() from SYS_ERROR
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> REC : recording_fsm_dispatch_event(REC_EVT_START, NULL)
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> TEST : Transition to SYS_RECORDING

TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_STREAMING_START)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_recording_and_uploading()
SYS -> SYS : do_action()
SYS -> COMM : comm_fsm_dispatch_event(COMM_EVT_START_STREAMING)
COMM -> COMM : entry_action()
COMM -> COMM : do_action()
SYS -> TEST : Transition to SYS_RECORDING_AND_UPLOADING

note over USER,COMM : Network disconnection during streaming
COMM -> COMM : COMM_EVT_NETWORK_DISCONNECTED
COMM -> SYS : comm_fsm_dispatch_event(COMM_EVT_NETWORK_DISCONNECTED)
SYS -> SYS : system_coordinator_dispatch_event(SYS_EVT_NETWORK_DISCONNECTED)
SYS -> SYS : exit_state() from SYS_RECORDING_AND_UPLOADING
SYS -> SYS : enter_recording()
SYS -> SYS : do_action()
SYS -> COMM : comm_fsm_dispatch_event(COMM_EVT_STOP_STREAMING)
COMM -> COMM : exit_action()
SYS -> TEST : Transition to SYS_RECORDING

note over USER,COMM : Scenario 10: System Reset and Recovery

USER -> TEST : Request system reset
TEST -> SYS : system_coordinator_dispatch_event(SYS_EVT_RESET)
SYS -> SYS : exit_state() from SYS_RECORDING
SYS -> SYS : enter_reset()
SYS -> SYS : do_action()
SYS -> REC : recording_fsm_dispatch_event(REC_EVT_STOP, NULL)
REC -> REC : exit_action()
SYS -> SYS : Clear error state
SYS -> SYS : transition_to_state(SYS_INIT)
SYS -> SYS : exit_state() from SYS_RESET
SYS -> SYS : enter_init()
SYS -> REC : recording_fsm_init()
REC -> REC : entry_action()
REC -> REC : do_action()
SYS -> SYS : No pending update
SYS -> SYS : transition_to_state(SYS_IDLE)
SYS -> SYS : exit_state() from SYS_INIT
SYS -> SYS : enter_idle()
SYS -> SYS : do_action()
SYS -> TEST : System reset complete, now in IDLE state

@enduml
