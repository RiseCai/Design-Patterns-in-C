@startuml Parallel Pipeline Data Flow Hybrid Model Sequence Diagram

title Parallel Pipeline Data Flow Hybrid Model Sequence Diagram

actor User as "Application"
participant WF as "ParallelWorkflow"
participant Task1 as "SensorTask"
participant Task2 as "ProcessorTask"
participant DS as "DataStreamService"
participant Stream1 as "sensor_data"

== Workflow Initialization ==
User -> WF: parallel_workflow_init_ex(enable_data_streams=1)
activate WF
WF -> DS: data_stream_service_create()
activate DS
DS --> WF: data_stream_service
WF --> User: workflow ready

== Task Configuration ==
User -> Task1: parallel_task_add_output_stream(sensor_data)
Task1 -> DS: register_output_stream(sensor_data)
DS --> Task1: stream registered

User -> Task2: parallel_task_add_input_stream(sensor_data)
Task2 -> DS: register_input_stream(sensor_data)
User -> Task2: parallel_task_add_dependency(Task1.task_id)
Task2 -> Task2: add_task_dependency(Task1)

== Workflow Start ==
User -> WF: parallel_workflow_start()
WF -> WF: set_state(PWORKFLOW_RUNNING)

== Execution Phase 1 ==
WF -> Task1: parallel_task_start()
activate Task1
Task1 -> Task1: execute_sensor_task()
Task1 -> Stream1: data_stream_write(sensor_reading)
activate Stream1
Stream1 -> Stream1: enqueue_data(sensor_reading)
Stream1 --> Task1: data_written
Task1 -> Task1: set_state(PTASK_COMPLETED)
Task1 -> WF: mark_task_completed(Task1)
deactivate Task1

== Execution Phase 2 ==
WF -> Task2: parallel_task_start()
activate Task2
Task2 -> Task2: execute_processor_task()
Task2 -> Stream1: data_stream_read(sensor_data)
Stream1 -> Stream1: dequeue_data()
Stream1 --> Task2: sensor_data
deactivate Stream1

Task2 -> Task2: process_sensor_data()
Task2 -> Task2: set_state(PTASK_COMPLETED)
Task2 -> WF: mark_task_completed(Task2)
deactivate Task2

== Completion Phase ==
WF -> WF: check_all_tasks_completed()
WF -> WF: set_state(PWORKFLOW_COMPLETED)
WF --> User: workflow_completed

deactivate DS
deactivate WF

@enduml
