@startuml Parallel Pipeline Deployment Diagram

' Enhanced layout optimization directives for complex deployment diagram
!pragma layout smetana

/'
    Parallel Pipeline Deployment Diagram
    ====================================

    This diagram shows the deployment architecture of the parallel pipeline system,
    illustrating how components are deployed across different environments and nodes.

    Software Architecture Layers:
    - Presentation Layer: Network infrastructure and entry points
    - Application Layer: Business logic and application servers
    - Infrastructure Layer: Data persistence and external systems

    Generated: 2026-01-05
    Version: 1.0
'/

title Parallel Pipeline Deployment Architecture

' === PRESENTATION LAYER ===
rectangle "Presentation Layer\n(Network & API Gateway)" as Presentation #LightBlue {
    node "Network Infrastructure" as Network #LightPink {
        component "Load Balancer" as LoadBalancer
        component "API Gateway" as Gateway
        component "Service Mesh" as Mesh
    }
}

' === APPLICATION LAYER ===
rectangle "Application Layer\n(Business Logic)" as Application #LightGreen {
    node "Parallel Pipeline Core" as CoreEngine #LightBlue {
        rectangle "Task Management" as TaskMgr #LightCyan {
            artifact "parallel_task.so" as TaskLib
            component "Task Lifecycle" as TaskLifecycle
            component "Dependency Resolution" as DependencyResolver
            component "Thread Management" as ThreadMgr
        }

        rectangle "Workflow Orchestration" as WorkflowMgr #LightCyan {
            artifact "parallel_workflow.so" as WorkflowLib
            component "Task Scheduling" as TaskScheduler
            component "Concurrency Control" as ConcurrencyCtrl
            component "State Management" as StateMgr
        }

        rectangle "Data Flow Engine" as DataFlow #LightCyan {
            artifact "data_stream_service.so" as DataStreamLib
            component "Stream Buffering" as StreamBuffer
            component "Synchronization" as DataSync
            component "Flow Control" as FlowCtrl
        }

        rectangle "Monitoring & Metrics" as MonitorSys #LightCyan {
            artifact "workflow_monitor.so" as MonitorLib
            component "Performance Metrics" as PerfMetrics
            component "Health Checks" as HealthChecks
            component "Event Logging" as EventLogger
        }
    }

    node "Configuration & Storage" as ConfigStorage #LightBlue {
        file "pipeline_config.json" as ConfigFile
        file "workflow_definitions.xml" as WorkflowDefs
        database "Local Cache DB" as CacheDB
        folder "Log Files" as LogDir
    }

    node "Service Processes" as Services #LightBlue {
        artifact "pipeline_service" as MainService
        artifact "pipeline_monitor" as MonitorService
        artifact "pipeline_admin" as AdminService
    }

    ' High Availability Node
    node "Backup Node\n(HA/Failover)" as BackupServer #LightBlue {
        artifact "parallel_pipeline.so\n(Standby)" as BackupMainLib
        component "State Replication" as StateSync
        component "Data Mirroring" as DataMirror
    }
}

' === INFRASTRUCTURE LAYER ===
rectangle "Infrastructure Layer\n(Data & External Systems)" as Infrastructure #LightGray {
    node "External Systems" as ExtSystems #LightYellow {
        database "Message Queue" as MQ
        database "Database" as DB
        cloud "APIs" as API
        folder "Storage" as Storage
        component "Monitoring" as Monitor
    }

    node "OS & Platform Layer" as Platform #LightGray {
        component "Systemd" as Systemd
        component "glibc" as GLIBC
        component "Memory Manager" as MemoryMgr
        component "Security Layer" as Security
    }
}

' Layer interconnections
Presentation --> Application : routes_requests
Application --> Infrastructure : data_access
Infrastructure --> Application : data_services

' Detailed component connections
Network --> CoreEngine : load_balancing
Network --> BackupServer : failover
CoreEngine --> Platform : depends_on
BackupServer --> Platform : depends_on
CoreEngine --> ExtSystems : data_flow
ExtSystems --> CoreEngine : data_sources

' Internal application connections within Core Engine
TaskLib --> ConfigFile : configuration
TaskLib --> WorkflowLib : orchestration
WorkflowLib --> DataStreamLib : data_flow
WorkflowLib --> MonitorLib : monitoring
TaskLib --> ThreadMgr : threading
WorkflowLib --> TaskScheduler : scheduling
DataStreamLib --> StreamBuffer : buffering
MonitorLib --> PerfMetrics : metrics

' Configuration and service connections
ConfigFile --> TaskLib : task_config
ConfigFile --> WorkflowLib : workflow_config
CacheDB --> TaskLib : task_cache
LogDir --> MonitorLib : logging
MainService --> CoreEngine : executes
MonitorService --> MonitorLib : health_monitoring
AdminService --> CoreEngine : management

' Deployment notes
note right of CoreEngine : Core Engine Components:\n- Task Management\n- Workflow Orchestration\n- Data Flow Engine\n- Monitoring System
note right of ConfigStorage : Configuration & Storage:\n- Pipeline Config JSON\n- Workflow Definitions\n- Local Cache DB\n- Log Files
note right of Services : Service Processes:\n- Main Pipeline Service\n- Monitoring Service\n- Admin Service
note right of BackupServer : High Availability:\n- Standby Pipeline\n- State Replication\n- Data Mirroring
note right of ExtSystems : External Dependencies:\n- MQ Systems\n- Databases\n- APIs\n- Storage\n- Monitoring
note right of Platform : Platform Services:\n- Process Management\n- Memory Allocation\n- Security Policies\n- System Libraries

@enduml
