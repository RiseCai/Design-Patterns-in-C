@startuml
title Acceptor FSM for Regular Expression "ab*" (with API Mapping)

skinparam state {
  BackgroundColor<<accepting>> LightGreen
  BorderColor<<accepting>> DarkGreen
  BackgroundColor<<reject>> LightPink
  BorderColor<<reject>> DarkRed
  BackgroundColor<<normal>> White
  BorderColor<<normal>> Black
  FontSize 13
}

state "q0 (initial)" as q0 <<normal>> {
  state "q0_Entry" as q0Entry <<entry>>
  state "q0_Do" as q0Do <<do>>
  state "q0_Exit" as q0Exit <<exit>>
}

state "q1 (accepting)" as q1 <<accepting>> {
  state "q1_Entry" as q1Entry <<entry>>
  state "q1_Do" as q1Do <<do>>
  state "q1_Exit" as q1Exit <<exit>>
}

state "reject" as reject <<reject>> {
  state "reject_Entry" as rejectEntry <<entry>>
  state "reject_Do" as rejectDo <<do>>
  state "reject_Exit" as rejectExit <<exit>>
}

[*] --> q0

q0 --> q1 : 'a'\nAPI: acceptor_machine_feed(am, 'a')
q0 --> reject : 'b'\nAPI: acceptor_machine_feed(am, 'b')

q1 --> q1 : 'b'\nAPI: acceptor_machine_feed(am, 'b')
q1 --> reject : 'a'\nAPI: acceptor_machine_feed(am, 'a')

reject --> reject : any\nAPI: acceptor_machine_feed(am, any)

' Labels
q0Entry : "reset counter"
q0Do : "wait for input"
q0Exit : "clear"

q1Entry : "set accepting flag"
q1Do : "count b's"
q1Exit : "reset accepting flag"

rejectEntry : "enter dead state"
rejectDo : "ignore input"
rejectExit : "reset"

note right of q0
  <b>Start state</b>
  <b>State struct:</b> acceptor_state (q0)
  <b>Transition table:</b> transitions[0] = {'a', q1}
  <b>API:</b> acceptor_machine_init(am, q0)
end note

note right of q1
  <b>Accepting state</b>
  <b>Matches "ab*"</b>
  <b>is_accepting = 1</b>
  <b>API:</b> acceptor_machine_is_accepting(am)
end note

note right of reject
  <b>Dead state (no acceptance)</b>
  <b>is_accepting = 0</b>
  <b>No outgoing transitions</b>
end note

@enduml
